# Kubernetes Secrets Template for Energy Trading Platform
# IMPORTANT: This is a TEMPLATE file. Do NOT commit real secrets!
#
# Usage:
# 1. Copy this file to secrets.yaml
# 2. Replace placeholder values with real secrets
# 3. Apply: kubectl apply -f secrets.yaml
# 4. Ensure secrets.yaml is in .gitignore
#
# For production, use:
# - External secret management (Vault, AWS Secrets Manager)
# - Sealed Secrets
# - SOPS with age/gpg encryption
apiVersion: v1
kind: Secret
metadata:
  name: trading-secrets
  namespace: trading
  labels:
    app.kubernetes.io/name: energy-trading-platform
    app.kubernetes.io/component: secrets
type: Opaque
stringData:
  # PostgreSQL credentials
  POSTGRES_USER: "trading"
  POSTGRES_PASSWORD: "REPLACE_WITH_REAL_PASSWORD"

  # Full PostgreSQL DSN (alternative)
  # POSTGRES_DSN: "postgresql://trading:REPLACE_WITH_REAL_PASSWORD@postgres.trading.svc.cluster.local:5432/trades"
