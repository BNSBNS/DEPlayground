# Energy Trading Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored - NEVER commit it.
# =============================================================================

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=trades
KAFKA_DLQ_TOPIC=trades-dlq
KAFKA_CONSUMER_GROUP=trade-aggregator

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trades
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# Producer Settings (LOCAL mode - synthetic data)
# =============================================================================
PRODUCER_RATE=10
PRODUCER_BURST_ENABLED=true
PRODUCER_BURST_MULTIPLIER=5
PRODUCER_BURST_DURATION=30
PRODUCER_BURST_INTERVAL=300

# =============================================================================
# Consumer Settings
# =============================================================================
WINDOW_DURATION_SECONDS=60
LATE_EVENT_GRACE_SECONDS=30
DB_BATCH_SIZE=100

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# Ingestion Mode (local, realtime, batch, hybrid)
# =============================================================================
INGESTION_MODE=local

# =============================================================================
# API Keys - External Data Sources
# =============================================================================
# Finnhub API (https://finnhub.io/register) - Free tier available
FINNHUB_API_KEY=your_finnhub_api_key_here

# ENTSO-E Transparency Platform (https://transparency.entsoe.eu/)
ENTSOE_API_KEY=your_entsoe_api_key_here

# =============================================================================
# Data Sources (REALTIME/HYBRID modes)
# =============================================================================

# --- WebSocket Source (Finnhub) - Stocks & Crypto ---
WS_ENABLED=false
WS_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,BINANCE:BTCUSDT

# --- SSE Source (DexPaprika) - Crypto prices (no API key needed) ---
SSE_ENABLED=false
SSE_SYMBOLS=BTC,ETH,SOL

# --- Polling Source (ENTSO-E) - European energy prices ---
POLLING_ENABLED=false
POLLING_AREAS=DE,FR,NL
POLLING_INTERVAL=60

# --- Batch Source - CSV/Parquet file processing ---
BATCH_ENABLED=false
BATCH_PATTERN=*.csv
BATCH_POLL_INTERVAL=60

# --- Micro-batch settings ---
MICROBATCH_ENABLED=false
MICROBATCH_WINDOW=10
MICROBATCH_SIZE=1000

# =============================================================================
# Superset Configuration
# =============================================================================
# Generate with: openssl rand -base64 42
SUPERSET_SECRET_KEY=change_me_generate_a_random_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@localhost

# =============================================================================
# Grafana Configuration
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# MinIO / S3 Credentials (for Lakehouse)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# =============================================================================
# API Settings
# =============================================================================
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# ML / Forecasting Module (optional extras: pip install -e ".[ml]")
# =============================================================================
ML_MODEL_NAME=lightgbm
ML_HORIZON_MINUTES=15
ML_SEQ_LEN=60
ML_SYMBOLS=["POWER_DE"]
ML_TRAIN_HISTORY_DAYS=30
ML_INFER_HISTORY_MINUTES=240
ML_EVAL_FOLDS=3
ML_MIN_TRAIN_ROWS=500
ML_MODEL_STORE_PATH=data/ml_models
ML_RETRAIN_CRON=0 2 * * *
ML_METRICS_PORT=8004

# Neural hyperparameters
ML_HIDDEN_SIZE=64
ML_NUM_LAYERS=2
ML_DROPOUT=0.1
ML_BATCH_SIZE=64
ML_EPOCHS=50
ML_LEARNING_RATE=0.001
ML_EARLY_STOPPING_PATIENCE=5
