# Energy Trading Platform - Secrets Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env.secrets and fill in your values
# The .env.secrets file is gitignored and should NEVER be committed
#
# For Kubernetes: These values should be stored in K8s Secrets
# For Docker: These can be mounted as Docker secrets
# =============================================================================

# =============================================================================
# Database Credentials
# =============================================================================
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_USER=trading

# =============================================================================
# API Keys - External Data Sources
# =============================================================================
# Finnhub API (https://finnhub.io/register) - Free tier available
FINNHUB_API_KEY=your_finnhub_api_key_here

# ENTSO-E Transparency Platform (https://transparency.entsoe.eu/)
ENTSOE_API_KEY=your_entsoe_api_key_here

# =============================================================================
# Application Secrets
# =============================================================================
# Superset secret key (generate with: openssl rand -base64 42)
SUPERSET_SECRET_KEY=generate_a_secure_random_key_here

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change_me_in_production

# Webhook validation secret
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# Kafka Security (Optional - for SSL/SASL)
# =============================================================================
# KAFKA_SSL_KEYSTORE_PASSWORD=
# KAFKA_SSL_KEY_PASSWORD=
# KAFKA_SSL_TRUSTSTORE_PASSWORD=
# KAFKA_SASL_PASSWORD=

# =============================================================================
# MinIO / S3 Credentials (for Lakehouse)
# =============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change_me_in_production
