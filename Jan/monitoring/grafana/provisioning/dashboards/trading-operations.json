{
  "dashboard": {
    "title": "Trading Operations",
    "uid": "trading-ops",
    "timezone": "utc",
    "refresh": "5s",
    "schemaVersion": 39,
    "panels": [
      {
        "title": "Messages Processed/sec",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [{"expr": "rate(messages_processed_total[1m])", "legendFormat": "{{symbol}}"}],
        "fieldConfig": {"defaults": {"unit": "msg/s"}}
      },
      {
        "title": "Consumer Lag",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [{"expr": "consumer_lag", "legendFormat": "partition-{{partition}}"}],
        "fieldConfig": {"defaults": {"unit": "short"}}
      },
      {
        "title": "DLQ Count",
        "type": "stat",
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
        "targets": [{"expr": "sum(dlq_messages_total)", "legendFormat": "Errors"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 1, "color": "red"}]}}}
      },
      {
        "title": "Active Windows",
        "type": "stat",
        "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
        "targets": [{"expr": "active_windows", "legendFormat": "Windows"}],
        "fieldConfig": {"defaults": {"thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 100, "color": "yellow"}, {"value": 500, "color": "red"}]}}}
      },
      {
        "title": "Data Freshness (sec)",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
        "targets": [{"expr": "max(data_freshness_seconds)", "legendFormat": "Lag"}],
        "fieldConfig": {"defaults": {"max": 120, "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 30, "color": "yellow"}, {"value": 60, "color": "red"}]}}}
      },
      {
        "title": "DB Write Latency P99",
        "type": "gauge",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
        "targets": [{"expr": "histogram_quantile(0.99, rate(db_write_duration_seconds_bucket[5m]))", "legendFormat": "P99"}],
        "fieldConfig": {"defaults": {"unit": "s", "max": 1, "thresholds": {"steps": [{"value": 0, "color": "green"}, {"value": 0.1, "color": "yellow"}, {"value": 0.5, "color": "red"}]}}}
      },
      {
        "title": "Processing Latency",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(processing_duration_seconds_bucket[5m]))", "legendFormat": "P50"},
          {"expr": "histogram_quantile(0.95, rate(processing_duration_seconds_bucket[5m]))", "legendFormat": "P95"},
          {"expr": "histogram_quantile(0.99, rate(processing_duration_seconds_bucket[5m]))", "legendFormat": "P99"}
        ],
        "fieldConfig": {"defaults": {"unit": "s"}}
      }
    ]
  }
}
