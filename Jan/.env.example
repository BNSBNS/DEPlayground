# Energy Trading Platform - Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Kafka Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=trades
KAFKA_DLQ_TOPIC=trades-dlq
KAFKA_CONSUMER_GROUP=trade-aggregator

# Producer-specific settings
# acks=all is hardcoded for durability (trading requirement)
# enable.idempotence=true is hardcoded for exactly-once producer semantics

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trades
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full DSN (alternative to individual settings)
# POSTGRES_DSN=postgresql://trading:trading@localhost:5432/trades

# =============================================================================
# Producer Settings
# =============================================================================
# Events per second (normal rate)
PRODUCER_RATE=10

# Enable burst mode to simulate market volatility
PRODUCER_BURST_ENABLED=true

# Multiplier during burst periods (5x = 50 events/sec during burst)
PRODUCER_BURST_MULTIPLIER=5

# Burst duration in seconds
PRODUCER_BURST_DURATION=30

# Time between bursts in seconds
PRODUCER_BURST_INTERVAL=300

# =============================================================================
# Consumer Settings
# =============================================================================
# Tumbling window duration in seconds
WINDOW_DURATION_SECONDS=60

# Grace period for late-arriving events (seconds)
LATE_EVENT_GRACE_SECONDS=30

# Maximum batch size for DB writes
DB_BATCH_SIZE=100

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# JSON logging for production (set to "true" in production)
LOG_JSON_FORMAT=false

# =============================================================================
# Application Settings
# =============================================================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Enable debug mode (additional logging, slower performance)
DEBUG=false
