# DataSecurity — environment variables
# Copy to .env and fill in values. NEVER commit .env.

# PostgreSQL connection (Phase 1 Docker setup)
DS_POSTGRES_URL=postgresql://datasec:datasec@localhost:5432/datasec_test

# MySQL connection (Phase 1 Docker setup)
DS_MYSQL_URL=mysql+pymysql://datasec:datasec@localhost:3306/datasec_test

# API security
DS_API_KEY=change-me-in-production

# Compliance configuration
DS_BUSINESS_TIMEZONE=Asia/Singapore
DS_OFF_HOURS_START=22
DS_OFF_HOURS_END=6

# PII detection
DS_PII_CONFIG_PATH=config/pii_patterns.yaml

# Thresholds
DS_BULK_SELECT_THRESHOLD=10000
DS_MAX_SAMPLE_ROWS=100
