# Fraud & Anomaly Detection Engine — Environment Variables

# Generator
GENERATOR_NUM_TRANSACTIONS=100000
GENERATOR_FRAUD_RATE=0.03
GENERATOR_NUM_USERS=5000
GENERATOR_NUM_MERCHANTS=200
GENERATOR_SEED=42

# Kafka (for alert emission — Phase 6+)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ALERTS_TOPIC=cysec.alerts

# API (Phase 6+)
API_PORT=8101
API_KEY=changeme

# Application
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
ENVIRONMENT=development
DEBUG=false
