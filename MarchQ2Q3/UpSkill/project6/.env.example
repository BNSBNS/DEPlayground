# Postgres
POSTGRES_DSN=postgresql://feature_store:feature_store@localhost:5432/feature_store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=feature_store
POSTGRES_USER=feature_store
POSTGRES_PASSWORD=feature_store

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:9093
KAFKA_CONSUMER_GROUP=feature-store-consumer

# API
API_PORT=8060

# Batch
BATCH_SCHEDULE_MINUTES=60
BATCH_BACKFILL_DAYS=90

# Stream
STREAM_ENABLED=true
