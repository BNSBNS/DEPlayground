# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming_analytics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CONSUMER_GROUP=streaming-analytics

# API
API_PORT=8040
API_CORS_ORIGINS=["http://localhost:3040","http://localhost:8040"]
WS_ENABLED=true

# Simulation
EVENTS_PER_SECOND=50
SIMULATION_SCENARIO=normal

# Schema Registry
SCHEMA_REGISTRY_URL=http://redpanda:8081
