# Database
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=observability

# Application
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
ENVIRONMENT=development
DEBUG=false

# API
API_PORT=8010
API_CORS_ORIGINS=http://localhost:3010,http://localhost:3000

# Detectors — default thresholds
FRESHNESS_WARNING_MINUTES=60
FRESHNESS_CRITICAL_MINUTES=120
VOLUME_LOOKBACK_DAYS=14
VOLUME_WARNING_ZSCORE=2.0
VOLUME_CRITICAL_ZSCORE=3.0
DISTRIBUTION_WARNING_PVALUE=0.05
DISTRIBUTION_CRITICAL_PVALUE=0.01

# RCA
RCA_CORRELATION_WINDOW_MINUTES=30

# Alerting
SLACK_WEBHOOK_URL=
ALERT_ENABLED=false

# Simulation
SIMULATION_MODE=false
SIMULATION_INTERVAL_SECONDS=30
