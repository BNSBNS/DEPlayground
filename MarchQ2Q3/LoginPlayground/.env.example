# Server
PORT=3000
MTLS_PORT=3443
NODE_ENV=development

# Database
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=local-dev-jwt-secret-change-in-prod
JWT_PRIVATE_KEY_PATH=./shared/keys/private.pem
JWT_PUBLIC_KEY_PATH=./shared/keys/public.pem
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Sessions
SESSION_SECRET=local-dev-session-secret-change-in-prod

# Keycloak — OIDC realm (mimics Google/GitHub)
OIDC_ISSUER=http://localhost:8080/realms/oidc
OIDC_CLIENT_ID=auth-lab-oidc
OIDC_CLIENT_SECRET=change-me-after-realm-import

# Keycloak — Entra realm (mimics Azure AD)
ENTRA_ISSUER=http://localhost:8080/realms/entra
ENTRA_CLIENT_ID=auth-lab-entra
ENTRA_CLIENT_SECRET=change-me-after-realm-import

# Keycloak — SAML realm
SAML_IDP_METADATA_URL=http://localhost:8080/realms/saml/protocol/saml/descriptor
SAML_SP_ENTITY_ID=auth-methods-lab
SAML_ACS_URL=http://localhost:3000/auth/saml/acs

# Email (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=auth-lab@localhost

# mTLS
MTLS_CA_PATH=./shared/certs/ca.pem
MTLS_SERVER_CERT_PATH=./shared/certs/server.pem
MTLS_SERVER_KEY_PATH=./shared/certs/server-key.pem
